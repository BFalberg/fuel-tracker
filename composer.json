{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "laravel/react-starter-kit",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": [
        "laravel",
        "framework"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "inertiajs/inertia-laravel": "^3.5.1",
        "laravel/framework": "^13.35",
        "laravel/wayfinder": "^0.1.21",
        "nunomaduro/essentials": "^1.2"
    },
    "require-dev": {
        "driftingly/rector-laravel": "^2.6.2",
        "fakerphp/faker": "^1.24.1",
        "larastan/larastan": "^3.13",
        "laravel/boost": "^2.10.3",
        "laravel/pail": "^1.2.7",
        "laravel/pao": "^1.1.5",
        "laravel/pint": "^1.32.1",
        "laravel/sail": "^1.68",
        "laravel/tinker": "^3.0.2",
        "laravel/vet": "^0.2.1",
        "mockery/mockery": "^1.6.15",
        "nunomaduro/collision": "^8.9.5",
        "pestphp/pest": "^5.3.1",
        "pestphp/pest-plugin-drift": "^5.0",
        "pestphp/pest-plugin-laravel": "^5.0.1",
        "pestphp/pest-plugin-type-coverage": "^5.0.3",
        "rector/rector": "^2.7",
        "roave/security-advisories": "dev-latest"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "npm install",
            "npm run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan dev"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force",
            "@php artisan clear",
            "@update:requirements"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "update:requirements": [
            "composer bump",
            "npx npm-check-updates -u"
        ],
        "lint": [
            "rector",
            "pint --parallel",
            "npm run lint"
        ],
        "test:type-coverage": "@php -d memory_limit=1G vendor/bin/pest --type-coverage --min=100",
        "test:lint": [
            "pint --parallel --test",
            "rector --dry-run",
            "@wayfinder",
            "npm run test:lint"
        ],
        "test:unit": [
            "@putenv XDEBUG_MODE=coverage",
            "@php artisan config:clear --ansi",
            "@php -d memory_limit=1G vendor/bin/pest --parallel --coverage --exactly=100.0"
        ],
        "test:types": [
            "phpstan analyse --memory-limit=1G",
            "@wayfinder",
            "npm run test:types"
        ],
        "test": [
            "@test:lint",
            "@test:types",
            "@test:type-coverage",
            "@test:unit"
        ],
        "wayfinder": "@php artisan wayfinder:generate --with-form --ansi"
    },
    "scripts-descriptions": {
        "lint": "Fix what can be fixed: Rector, Pint, then the frontend formatter and linter.",
        "wayfinder": "Generate the Wayfinder TypeScript routes and actions (gitignored).",
        "test:lint": "Check mode only: Pint, Rector, then the frontend formatter and linter.",
        "test:types": "Static analysis: PHPStan (Larastan, level max), then the TypeScript type check.",
        "test:type-coverage": "Pest type coverage. Fails below 100%.",
        "test:unit": "Clear the config cache, then run the Pest suite in parallel with code coverage. Fails below exactly 100%. Needs a coverage driver (pcov or Xdebug).",
        "test": "Everything CI runs: test:lint, test:types, test:type-coverage, test:unit.",
        "setup": "Install the dependencies, create .env, migrate and build the frontend.",
        "update:requirements": "Bump the Composer and npm version constraints to the installed versions."
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true,
            "laravel/vet": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
