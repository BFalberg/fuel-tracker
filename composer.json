{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "laravel/react-starter-kit",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": [
        "laravel",
        "framework"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "inertiajs/inertia-laravel": "^3.5",
        "laravel/framework": "^13.35",
        "laravel/tinker": "^3.0",
        "laravel/wayfinder": "^0.1.21",
        "nunomaduro/essentials": "^1.2"
    },
    "require-dev": {
        "driftingly/rector-laravel": "^2.6",
        "fakerphp/faker": "^1.24",
        "larastan/larastan": "^3.13",
        "laravel/boost": "^2.10",
        "laravel/pail": "^1.2.7",
        "laravel/pint": "^1.24",
        "laravel/sail": "^1.68",
        "laravel/vet": "^0.2.1",
        "mockery/mockery": "^1.6.12",
        "nunomaduro/collision": "^8.9.5",
        "pestphp/pest": "^5.3",
        "pestphp/pest-plugin-drift": "^5.0",
        "pestphp/pest-plugin-laravel": "^5.0",
        "pestphp/pest-plugin-type-coverage": "^5.0.3",
        "rector/rector": "^2.7",
        "roave/security-advisories": "dev-latest"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1\" \"php artisan pail --timeout=0\" \"npm run dev\" --names=server,queue,logs,vite"
        ],
        "lint": [
            "rector",
            "pint --parallel",
            "npm run lint"
        ],
        "test:lint": [
            "pint --parallel --test",
            "rector --dry-run",
            "@wayfinder",
            "npm run test:lint"
        ],
        "test:types": [
            "phpstan analyse --memory-limit=1G",
            "@wayfinder",
            "npm run test:types"
        ],
        "test:type-coverage": "@php -d memory_limit=1G vendor/bin/pest --type-coverage --min=100",
        "test:unit": [
            "@php artisan config:clear --ansi",
            "pest --parallel"
        ],
        "test:coverage": [
            "@php artisan config:clear --ansi",
            "@php -d memory_limit=1G vendor/bin/pest --parallel --coverage --min=80"
        ],
        "test": [
            "@test:lint",
            "@test:types",
            "@test:type-coverage",
            "@test:unit"
        ],
        "wayfinder": "@php artisan wayfinder:generate --with-form --ansi"
    },
    "scripts-descriptions": {
        "lint": "Fix what can be fixed: Rector, Pint, then the frontend formatter and linter.",
        "wayfinder": "Generate the Wayfinder TypeScript routes and actions (gitignored).",
        "test:lint": "Check mode only: Pint, Rector, then the frontend formatter and linter.",
        "test:types": "Static analysis: PHPStan (Larastan, level max), then the TypeScript type check.",
        "test:type-coverage": "Pest type coverage. Fails below 100%.",
        "test:unit": "Clear the config cache, then run the Pest suite in parallel.",
        "test:coverage": "Pest code coverage. Fails below 80%. Needs a coverage driver (pcov in CI).",
        "test": "Everything CI runs except code coverage: test:lint, test:types, test:type-coverage, test:unit."
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true,
            "laravel/vet": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
